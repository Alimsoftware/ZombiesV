<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>ZombiesMod</RootNamespace>
    <AssemblyName>ZombiesMod</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS0618;CS1591;CS0067;CS0414;CS0169;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referências reais: SHVDN3 3.7.0.189 + LemonUI.SHVDN3 2.2.0 -->
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>..\dlls\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath>..\dlls\LemonUI.SHVDN3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      pt.json vai DUAS vezes de propósito:
        1. embutido no DLL  -> se os ficheiros externos faltarem ou corromperem, o jogo
           continua a mostrar português em vez de chaves cruas;
        2. copiado para ZombiesMod\lang -> é a cópia que a comunidade edita/ traduz, e que vence
           sempre sobre a embutida.
      O carregador procura um recurso cujo nome termine em "pt.json", daí o LogicalName fixo.
    -->
    <EmbeddedResource Include="ZombiesMod_lang\pt.json">
      <LogicalName>ZombiesMod_lang.pt.json</LogicalName>
    </EmbeddedResource>
    <Content Include="ZombiesMod_lang\*.json" Link="ZombiesMod\lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copia as refs junto só pra facilitar o deploy na pasta scripts -->
  <Target Name="CopyRefsForDeploy" AfterTargets="Build" Condition="'$(DeployRefs)' == 'true'">
    <Copy SourceFiles="..\dlls\LemonUI.SHVDN3.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Depois de compilar, copia a DLL e o pdb para a pasta scripts do jogo (se existir). -->
  <PropertyGroup>
    <GameScriptsDir Condition="'$(GameScriptsDir)' == ''">J:\GTAV\scripts\</GameScriptsDir>
  </PropertyGroup>
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameScriptsDir)')">
    <Copy SourceFiles="$(TargetDir)ZombiesMod.dll;$(TargetDir)ZombiesMod.pdb" DestinationFolder="$(GameScriptsDir)" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
